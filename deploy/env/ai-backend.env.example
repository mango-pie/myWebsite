# 复制到服务器 /etc/ai-backend.env 并填入真实值
# chmod 600 /etc/ai-backend.env
#
# 2GB 小机器约定（与 application-prod.yml 一致）：
#   Redis 关闭；本机不连 pgvector/MinIO；关掉 TTS 与应用工坊。
#   精读工作台仍要 APP_MODULES_KNOWLEDGE=true（笔记在本库；向量库在另一台机）。

# ---- 服务器（IP 访问模式）----
SERVER_IP=121.43.177.236

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aiscene
DB_PASSWORD=change-me

# ---- Redis：本机不使用（必须 off，不要留 auto 去探测）----
APP_REDIS_MODE=off
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ---- 模块（prod 已默认关 TTS / 应用工坊；此处可再覆盖）----
APP_MODULES_TTS=false
APP_MODULES_APP_LAB=false
APP_MODULES_KNOWLEDGE=true
APP_MODULES_READING=true

# ---- 知识库向量/对象存储在另一台机器，本机不要连 ----
KNOWLEDGE_VECTOR_ENABLED=false
KNOWLEDGE_MINIO_ENABLED=false
KNOWLEDGE_READING_MAX_MERGE_RAW_CHARS=240000

# ---- AI 服务（必填）----
DASHSCOPE_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-key
CHAT_IMAGE_CAPTION_API_KEY=sk-your-dashscope-key

CODEGEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CODEGEN_API_KEY=sk-your-codegen-key
CODEGEN_MODEL_NAME=deepseek-v3

# ---- AstrBot 聊天（Ask 模式）----
ASTRBOT_BASE_URL=http://121.40.253.15:6185
ASTRBOT_API_KEY=abk-your-astrbot-key

# ---- 站点 URL（IP 模式）----
APP_DEPLOY_HOST=http://121.43.177.236
UPLOAD_BASE_URL=http://121.43.177.236/api
# CORS_ALLOWED_ORIGIN_PATTERNS=http://121.43.177.236

# ---- TTS（本机关闭）----
GPT_SOVITS_SEED_ENABLED=false
